{
  "manifest_version": 3,
  "name": "PhishLens — Real-time Phishing Protection",
  "version": "1.0.0",
  "description": "Client-side phishing detection: typosquats, homoglyph domains, credential-harvest forms and social-engineering language — analyzed locally, nothing leaves your browser.",
  "permissions": ["tabs"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["engine.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishLens",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
